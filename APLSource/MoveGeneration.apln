:Namespace MoveGeneration
    ⎕IO ⎕ML←1                                       
 
    generatePseudoLegalMoves←{
        ⍝ ⍺ ←→ lookup tables
        ⍝ ⍵ ←→ bitboard, game state
        ⍝ ← ←→ matrix of (from to promotion); promotion is 0 for a
        ⍝      non-promoting move, otherwise the piece type promoted to
        lookups←⍺
        (bitboard game_state)←⍵
        P←##.Pieces
        side←game_state[##.GameState.side]
        offset←6×side
        own←∨⌿bitboard[offset+⍳6;]
        enemy←∨⌿bitboard[(6-offset)+⍳6;]
        occupied←own∨enemy
        squaresOf←{⍸bitboard[offset+⍵;]}

        ⍝ One attack matrix for all non-pawn pieces: a row per piece,
        ⍝ a column per square, in the same order as from.
        types←P.(N B R Q K)
        from←∊squaresOf¨types
        attacks←⊃⍪/{lookups pieceAttacks ⍵(squaresOf ⍵)occupied}¨types
        piece_moves←from expand attacks∧⍤1⊢~own

        pawn_squares←squaresOf P.P
        pawn_direction←8-16×side
        pawn_home_rank←2+5×side
        en_passant←game_state[##.GameState.en_passant_square]=⍳64

        single_push_from←pawn_squares/⍨~occupied[pawn_squares+pawn_direction]
        double_push_from←single_push_from/⍨pawn_home_rank=⌈single_push_from÷8
        double_push_from←double_push_from/⍨~occupied[double_push_from+2×pawn_direction]
        captures←⍺.pawn[1+side;pawn_squares;]∧⍤1⊢enemy∨en_passant

        pawn_moves←single_push_from,⍪single_push_from+pawn_direction
        pawn_moves⍪←double_push_from,⍪double_push_from+2×pawn_direction
        pawn_moves⍪←pawn_squares expand captures

        ⍝ A pawn reaching rank 1 or 8 yields one move per promotion piece.
        promotions←1 8∊⍨⌈pawn_moves[;2]÷8
        promoting←(pawn_moves⌿⍨4×promotions),(4×+/promotions)⍴P.(Q R B N)

        (piece_moves,0)⍪promoting⍪(~promotions)⌿pawn_moves,0
    }

    expand←{
        ⍝ ⍺ ←→ from squares, one per row of ⍵
        ⍝ ⍵ ←→ boolean matrix, (≢⍺)×64; 1 marks a reachable square
        ⍝ ← ←→ matrix of (from to), one row per 1 in ⍵
        hits←↑⍸⍵
        ⍺[hits[;1]],⍪hits[;2]
    }

    pieceAttacks←{
        ⍝ ⍺ ←→ lookup tables
        ⍝ ⍵ ←→ piece type, from squares, occupancy
        ⍝ ← ←→ boolean matrix, one row per from square, one column per square
        (piece squares occupied)←⍵
        P←##.Pieces
        L←##.LookupTables
        piece=P.N:⍺.knight[squares;]
        piece=P.K:⍺.king[squares;]
        piece=P.B:⍺ slidingAttacks squares L.diagonal occupied
        piece=P.R:⍺ slidingAttacks squares L.orthogonal occupied
        ⍺ slidingAttacks squares L.(orthogonal,diagonal)occupied
    }

    slidingAttacks←{
        ⍝ ⍺ ←→ lookup tables
        ⍝ ⍵ ←→ from squares, ray directions, occupancy
        ⍝ ← ←→ boolean matrix, one row per from square, one column per square
        ⍝ Each ray ends at its first occupied square, which stays reachable
        ⍝ so that captures are included; own pieces are removed by the caller.
        (squares directions occupied)←⍵
        ⍝ Each on an empty array calls its operand on the prototype, whose
        ⍝ zeros are not valid squares.
        0=≢squares:0 64⍴0
        reach←{⍵/⍨~¯1↓0,∨\occupied[⍵]}¨⍺.rays[directions;squares]
        ⍉(⍳64)∘.∊,⌿reach
    }

    checkSquareAttacked←{
        ⍝ ⍺ ←→
        ⍝ ⍵ ←→
        ⍝ ← ←→
        ()
    }
 
    ∇ perft board
   
    ∇
 
    ∇ new_board←board makeMove move
    
    ∇
 
 
:EndNamespace
 