:Namespace BoardTests
    ⎕IO ⎕ML←1

    ⍝ Each test parses its own FEN through parse, so a parser that cannot
    ⍝ load or crashes is reported per test rather than for the whole suite.
    parse←{#.DeepOrange.Board.initFromFEN ⍵}
    bitboard←{⊃parse ⍵}
    state←{2⊃parse ⍵}
    on←{⍸(⊃parse ⍺)[⍵;]}

    ⍝ Piece placement

    test_returns_twelve_bitboards_of_sixty_four_squares←{
        12 64 #.Tests.Framework.Assert.eq ⍴bitboard #.Tests.Helpers.START
    }

    test_places_white_pawns_on_rank_two←{
        (#.Tests.Helpers.sqs'a2 b2 c2 d2 e2 f2 g2 h2')#.Tests.Framework.Assert.eq #.Tests.Helpers.START on #.DeepOrange.Pieces.P
    }

    test_places_black_pawns_on_rank_seven←{
        (#.Tests.Helpers.sqs'a7 b7 c7 d7 e7 f7 g7 h7')#.Tests.Framework.Assert.eq #.Tests.Helpers.START on #.DeepOrange.Pieces.p
    }

    test_places_white_king_on_e1←{
        (,#.Tests.Helpers.sq'e1')#.Tests.Framework.Assert.eq #.Tests.Helpers.START on #.DeepOrange.Pieces.K
    }

    test_places_black_queen_on_d8←{
        (,#.Tests.Helpers.sq'd8')#.Tests.Framework.Assert.eq #.Tests.Helpers.START on #.DeepOrange.Pieces.q
    }

    test_places_white_rooks_in_the_corners_of_rank_one←{
        (#.Tests.Helpers.sqs'a1 h1')#.Tests.Framework.Assert.eq #.Tests.Helpers.START on #.DeepOrange.Pieces.R
    }

    test_leaves_ranks_three_to_six_empty←{
        (32⍴0)#.Tests.Framework.Assert.eq ∨⌿(bitboard #.Tests.Helpers.START)[;16+⍳32]
    }

    test_puts_at_most_one_piece_on_each_square←{
        #.Tests.Framework.Assert.ok ∧/1≥+⌿bitboard #.Tests.Helpers.START
    }

    test_expands_digits_into_empty_squares←{
        fen←'8/8/8/8/3N4/8/8/8 w - - 0 1'
        (,#.Tests.Helpers.sq'd4')#.Tests.Framework.Assert.eq fen on #.DeepOrange.Pieces.N
    }

    test_initBoard_sets_up_the_start_position←{
        (parse #.Tests.Helpers.START)#.Tests.Framework.Assert.eq #.DeepOrange.Board.initBoard ⍬
    }

    ⍝ Game state fields

    test_reads_white_to_move←{
        0 #.Tests.Framework.Assert.eq(state #.Tests.Helpers.START)[#.DeepOrange.GameState.side]
    }

    test_reads_black_to_move←{
        1 #.Tests.Framework.Assert.eq(state'8/8/8/8/8/8/8/8 b - - 0 1')[#.DeepOrange.GameState.side]
    }

    test_reads_castling_rights_cases←(
        ('all'('KQkq' (1 1 1 1)))
        ('none'('-' (0 0 0 0)))
        ('white kingside and black queenside'('Kq' (1 0 0 1)))
    )
    test_reads_castling_rights←{
        (field expected)←⍵
        expected #.Tests.Framework.Assert.eq(state'8/8/8/8/8/8/8/8 w ',field,' - 0 1')[#.DeepOrange.GameState.castling_rights]
    }

    test_reads_en_passant_square_cases←(
        ('none'('-' 0))
        ('e3'('e3' 21))
        ('d6'('d6' 44))
    )
    test_reads_en_passant_square←{
        (field expected)←⍵
        expected #.Tests.Framework.Assert.eq(state'8/8/8/8/8/8/8/8 w - ',field,' 0 1')[#.DeepOrange.GameState.en_passant_square]
    }

    test_reads_halfmove_and_fullmove_clocks←{
        5 42 #.Tests.Framework.Assert.eq(state'8/8/8/8/8/8/8/8 w - - 5 42')[#.DeepOrange.GameState.(halfmove fullmove)]
    }

    test_defaults_clocks_when_fen_omits_them←{
        0 1 #.Tests.Framework.Assert.eq(state'8/8/8/8/8/8/8/8 w - -')[#.DeepOrange.GameState.(halfmove fullmove)]
    }

:EndNamespace
