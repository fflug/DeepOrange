:Namespace GameStateTests
    ⎕IO ⎕ML←1

    setup←{
        (full:(side:1 ⋄ castling_rights:1 0 1 0 ⋄ en_passant_square:20 ⋄ halfmove:3 ⋄ fullmove:12))
    }

    FIELDS←'side' 'castling_rights' 'en_passant_square' 'halfmove' 'fullmove'

    test_returns_one_slot_per_index←{
        (⌈/∊#.DeepOrange.GameState.(side castling_rights en_passant_square halfmove fullmove))#.Tests.Framework.Assert.eq ≢#.DeepOrange.GameState.init ⍺.full
    }

    test_reads_side_from_the_namespace←{
        1 #.Tests.Framework.Assert.eq(#.DeepOrange.GameState.init ⍺.full)[#.DeepOrange.GameState.side]
    }

    test_reads_castling_rights_from_the_namespace←{
        1 0 1 0 #.Tests.Framework.Assert.eq(#.DeepOrange.GameState.init ⍺.full)[#.DeepOrange.GameState.castling_rights]
    }

    test_reads_the_en_passant_square_from_the_namespace←{
        20 #.Tests.Framework.Assert.eq(#.DeepOrange.GameState.init ⍺.full)[#.DeepOrange.GameState.en_passant_square]
    }

    test_reads_the_halfmove_clock_from_the_namespace←{
        3 #.Tests.Framework.Assert.eq(#.DeepOrange.GameState.init ⍺.full)[#.DeepOrange.GameState.halfmove]
    }

    test_reads_the_fullmove_number_from_the_namespace←{
        12 #.Tests.Framework.Assert.eq(#.DeepOrange.GameState.init ⍺.full)[#.DeepOrange.GameState.fullmove]
    }

    test_ignores_unrelated_fields_such_as_bitboard←{
        ns←⎕NS ⍺.full
        ns.bitboard←12 64⍴0
        (#.DeepOrange.GameState.init ⍺.full)#.Tests.Framework.Assert.eq #.DeepOrange.GameState.init ns
    }

    test_rejects_a_namespace_missing_a_field_cases←{⍵ ⍵}¨FIELDS
    test_rejects_a_namespace_missing_a_field←{
        ns←⎕NS ⍺.full
        _←ns.⎕EX ⍵
        (#.DeepOrange.GameState.init #.Tests.Framework.Assert.raises 6)ns
    }

:EndNamespace
