:Namespace Helpers
    ⍝ Chess-specific helpers shared by the test suites.
    ⎕IO ⎕ML←1

    sq←{
        ⍝ Algebraic square name to board index; a1 ←→ 1, h1 ←→ 8, a2 ←→ 9, h8 ←→ 64.
        ⍝ ⍵ ←→ square name, e.g. 'e4'
        ('abcdefgh'⍳⊃⍵)+8×¯1+'12345678'⍳⊃⌽⍵
    }

    sqs←{
        ⍝ Space-separated square names to a vector of indices, in the given order.
        ⍝ ⍵ ←→ e.g. 'e2 e4'
        sq¨' '(≠⊆⊢)⍵
    }

    sortRows←{
        ⍝ Rows of a move matrix in ascending order, so comparisons ignore
        ⍝ the order in which moves were generated.
        ⍵[⍋⍵;]
    }

    mirror←{
        ⍝ FEN of the position with the board reflected top to bottom and
        ⍝ the colours swapped, including the side to move. Its evaluation
        ⍝ from the side to move's point of view is that of the original.
        ⍝ ⍵ ←→ FEN
        fields←' '(≠⊆⊢)⍵
        (pieces side castling en_passant)←4↑fields
        pieces←¯1↓∊(swapCase¨⌽'/'(≠⊆⊢)pieces),¨'/'
        side←,'wb'['bw'⍳⊃side]
        castling←swapCase castling
        en_passant←{⍵≡,'-':⍵ ⋄ (⊃⍵),'63'['36'⍳⊃⌽⍵]}en_passant
        ¯1↓∊(pieces side castling en_passant,4↓fields),¨' '
    }

    swapCase←{
        ⍝ Letters with upper and lower case exchanged; other characters kept.
        upper←⎕A
        lower←⎕C ⎕A
        from←upper,lower
        to←lower,upper
        m←⍵∊from
        (to[from⍳m/⍵])@(⍸m)⊢⍵
    }

    START←'rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1'

:EndNamespace
