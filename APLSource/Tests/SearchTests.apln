:Namespace SearchTests
    ⎕IO ⎕ML←1

    setup←{#.DeepOrange.LookupTables.createLookupTables ⍬}

    pick←{
        ⍝ ⍺ ←→ lookup tables
        ⍝ ⍵ ←→ FEN
        ⍺ #.DeepOrange.Search.randomMove #.DeepOrange.Board.initFromFEN ⍵
    }

    legal←{
        ⍝ ⍺ ←→ lookup tables
        ⍝ ⍵ ←→ FEN
        ↓⍺ #.DeepOrange.MoveGeneration.generateLegalMoves #.DeepOrange.Board.initFromFEN ⍵
    }

    test_returns_a_legal_move←{
        #.Tests.Framework.Assert.ok(⊂⍺ pick #.Tests.Helpers.START)∊⍺ legal #.Tests.Helpers.START
    }

    test_returns_a_legal_move_for_black←{
        fen←'rnbqkbnr/pppppppp/8/8/4P3/8/PPPP1PPP/RNBQKBNR b KQkq e3 0 1'
        #.Tests.Framework.Assert.ok(⊂⍺ pick fen)∊⍺ legal fen
    }

    test_returns_a_three_item_move_vector←{
        (,3)#.Tests.Framework.Assert.eq⍴⍺ pick #.Tests.Helpers.START
    }

    test_returns_the_only_legal_move←{
        ⍝ The rook on the b-file leaves the king a single square.
        ((#.Tests.Helpers.sqs'a8 a7'),0)#.Tests.Framework.Assert.eq ⍺ pick'k7/8/8/8/8/8/8/1R5K b - - 0 1'
    }

    test_chooses_every_legal_move_over_many_draws←{
        ⍝ With 20 equally likely moves, 1000 draws miss a given move with
        ⍝ probability (19÷20)*1000, below 1E¯22.
        lookups←⍺
        drawn←∪{lookups pick #.Tests.Helpers.START}¨⍳1000
        #.Tests.Framework.Assert.ok(⍺ legal #.Tests.Helpers.START)≡⍥{⍵[⍋⍵]}drawn
    }

    test_returns_an_empty_vector_when_checkmated←{
        ⍬ #.Tests.Framework.Assert.eq ⍺ pick'k7/1Q6/1K6/8/8/8/8/8 b - - 0 1'
    }

    test_returns_an_empty_vector_when_stalemated←{
        ⍬ #.Tests.Framework.Assert.eq ⍺ pick'k7/8/1Q6/8/8/8/8/7K b - - 0 1'
    }

    ⍝ negamax and bestMove

    ⍝ Scores are in centipawns from the point of view of the side to move.
    ⍝ A side checkmated ply half-moves from the root scores ply-MATE, so
    ⍝ from the winning side a faster mate scores higher.

    position←{#.DeepOrange.Board.initFromFEN ⍵}

    ⍝ negamax returns (score nodes) and bestMove returns (move score
    ⍝ nodes), where nodes counts the positions searched, the root
    ⍝ included.

    search←{
        ⍝ ⍺ ←→ lookup tables
        ⍝ ⍵ ←→ depth, FEN
        ⍝ ← ←→ score, nodes
        (depth fen)←⍵
        ⍺ #.DeepOrange.Search.negamax depth,position fen
    }

    score←{⊃⍺ search ⍵}

    nodes←{2⊃⍺ search ⍵}

    bestSearch←{
        ⍝ ⍺ ←→ lookup tables
        ⍝ ⍵ ←→ depth, FEN
        ⍝ ← ←→ move, score, nodes
        (depth fen)←⍵
        ⍺ #.DeepOrange.Search.bestMove depth,position fen
    }

    best←{⊃⍺ bestSearch ⍵}

    isCheckmate←{
        ⍝ ⍺ ←→ lookup tables
        ⍝ ⍵ ←→ bitboards, game state
        ⍝ ← ←→ 1 if the side to move is in check and has no legal move
        (bitboards game_state)←⍵
        side←game_state[#.DeepOrange.GameState.side]
        king←⍸bitboards[(6×side)+#.DeepOrange.Pieces.K;]
        in_check←⊃⍺ #.DeepOrange.MoveGeneration.checkSquareAttacked bitboards king(~side)
        in_check∧0=≢⍺ #.DeepOrange.MoveGeneration.generateLegalMoves ⍵
    }

    hasMateInOne←{
        ⍝ ⍺ ←→ lookup tables
        ⍝ ⍵ ←→ bitboards, game state
        ⍝ ← ←→ 1 if some legal move checkmates the opponent
        lookups←⍺
        moves←↓⍺ #.DeepOrange.MoveGeneration.generateLegalMoves ⍵
        ∨/{lookups isCheckmate ⍵}¨⍵∘#.DeepOrange.MoveGeneration.makeMove¨moves
    }

    ⍝ White to move: Qb7, Qa7 and Qh8 all mate.
    MATE_IN_ONE←'k7/7Q/1K6/8/8/8/8/8 w - - 0 1'

    ⍝ Cases are built when the suite is fixed, before Helpers is loaded,
    ⍝ so they name the start position through this copy.
    START←'rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1'

    ⍝ White to move: exd5 wins the queen.
    WON_PIECE←'k7/8/8/3q4/4P3/8/8/K7 w - - 0 1'

    ⍝ White to move: Rxa7 wins a knight but leaves the back rank open to
    ⍝ Re1 mate.
    BACK_RANK←'4r1k1/n7/8/8/8/8/5PPP/R5K1 w - - 0 1'

    test_depth_zero_scores_a_quiet_position_by_its_evaluation←{
        fen←'k7/8/8/8/8/8/P7/K7 w - - 0 1'
        (#.DeepOrange.Evaluation.evaluate position fen)#.Tests.Framework.Assert.eq ⍺ score 0 fen
    }

    test_depth_zero_recognises_checkmate←{
        ⍝ The side to move is in check, so the search does not stop at
        ⍝ depth zero and finds that there are no legal moves.
        (-#.DeepOrange.Search.MATE)#.Tests.Framework.Assert.eq ⍺ score 0 'k7/1Q6/1K6/8/8/8/8/8 b - - 0 1'
    }

    test_scores_a_checkmated_position_as_lost←{
        (-#.DeepOrange.Search.MATE)#.Tests.Framework.Assert.eq ⍺ score 2 'k7/1Q6/1K6/8/8/8/8/8 b - - 0 1'
    }

    test_scores_a_stalemated_position_as_a_draw←{
        0 #.Tests.Framework.Assert.eq ⍺ score 1 'k7/8/1Q6/8/8/8/8/7K b - - 0 1'
    }

    test_scores_mate_in_one←{
        (#.DeepOrange.Search.MATE-1)#.Tests.Framework.Assert.eq ⍺ score 1 MATE_IN_ONE
    }

    test_prefers_the_fastest_mate←{
        ⍝ A deeper search also finds slower mates; the score is still
        ⍝ that of the mate in one.
        (#.DeepOrange.Search.MATE-1)#.Tests.Framework.Assert.eq ⍺ score 3 MATE_IN_ONE
    }

    test_scores_a_won_piece←{
        ⍝ White is a queen down unless exd5 wins it back; afterwards the
        ⍝ only material left is one white pawn.
        #.Tests.Framework.Assert.ok 0<⍺ score 2 WON_PIECE
    }

    test_best_move_plays_mate_in_one←{
        move←⍺ best 2 MATE_IN_ONE
        #.Tests.Framework.Assert.ok ⍺ isCheckmate(position MATE_IN_ONE)#.DeepOrange.MoveGeneration.makeMove move
    }

    test_best_move_takes_a_free_queen←{
        ((#.Tests.Helpers.sqs'e4 d5'),0)#.Tests.Framework.Assert.eq ⍺ best 2 WON_PIECE
    }

    test_best_move_avoids_allowing_mate_in_one←{
        ⍝ Taking the knight scores best by material, but only checks at
        ⍝ the horizon reveal that it allows mate.
        move←⍺ best 2 BACK_RANK
        #.Tests.Framework.Assert.ok~⍺ hasMateInOne(position BACK_RANK)#.DeepOrange.MoveGeneration.makeMove move
    }

    test_best_move_returns_an_empty_vector_when_checkmated←{
        ⍬ #.Tests.Framework.Assert.eq ⍺ best 2 'k7/1Q6/1K6/8/8/8/8/8 b - - 0 1'
    }

    test_best_move_returns_an_empty_vector_when_stalemated←{
        ⍬ #.Tests.Framework.Assert.eq ⍺ best 2 'k7/8/1Q6/8/8/8/8/7K b - - 0 1'
    }

    ⍝ Node counts

    ⍝ Black to move, in check from the rook on a1, with Kb8 and Kb7 as
    ⍝ its only moves; neither gives check.
    CHECKED←'k7/8/8/8/8/8/8/R6K b - - 0 1'

    test_counts_a_leaf_as_one_position←{
        1 #.Tests.Framework.Assert.eq ⍺ nodes 0 'k7/8/8/8/8/8/P7/K7 w - - 0 1'
    }

    test_counts_a_checkmated_position_as_one_position←{
        1 #.Tests.Framework.Assert.eq ⍺ nodes 2 'k7/1Q6/1K6/8/8/8/8/8 b - - 0 1'
    }

    ⍝ Each case: depth, positions searched from the start position. The
    ⍝ start position has 20 moves and 400 two-move sequences, none of
    ⍝ which gives check.
    test_counts_every_position_searched_cases←(
        ('depth one'(1 21))
        ('depth two'(2 421))
    )
    test_counts_every_position_searched←{
        (depth expected)←⍵
        expected #.Tests.Framework.Assert.eq ⍺ nodes depth #.Tests.Helpers.START
    }

    test_counts_the_positions_searched_by_the_check_extension←{
        3 #.Tests.Framework.Assert.eq ⍺ nodes 0 CHECKED
    }

    ⍝ Each case: depth, FEN. The score bestMove reports is the negamax
    ⍝ score of the position.
    test_best_move_reports_the_score_of_the_position_cases←(
        ('won piece'(2 WON_PIECE))
        ('start position'(3 START))
        ('back-rank mate threat'(3 BACK_RANK))
    )
    test_best_move_reports_the_score_of_the_position←{
        (⍺ score ⍵)#.Tests.Framework.Assert.eq 2⊃⍺ bestSearch ⍵
    }

    test_best_move_searches_fewer_positions_than_negamax←{
        #.Tests.Framework.Assert.ok(3⊃⍺ bestSearch 3 #.Tests.Helpers.START)<⍺ nodes 3 #.Tests.Helpers.START
    }

    test_best_move_counts_a_checkmated_root_as_one_position←{
        1 #.Tests.Framework.Assert.eq 3⊃⍺ bestSearch 2 'k7/1Q6/1K6/8/8/8/8/8 b - - 0 1'
    }

    ⍝ alphaBeta

    ⍝ alphaBeta returns (score nodes) like negamax, but skips moves that
    ⍝ cannot change the result. Given a window (alpha beta), a score
    ⍝ inside it is exact; a score at or below alpha only shows that the
    ⍝ true score is at most alpha, and one at or above beta that it is at
    ⍝ least beta. Without a window the score is exact.

    abSearch←{
        ⍝ ⍺ ←→ lookup tables
        ⍝ ⍵ ←→ depth, FEN[, alpha, beta]
        ⍝ ← ←→ score, nodes
        depth←⊃⍵
        fen←2⊃⍵
        window←2↓⍵
        ⍺ #.DeepOrange.Search.alphaBeta(depth,position fen),window
    }

    abScore←{⊃⍺ abSearch ⍵}

    abNodes←{2⊃⍺ abSearch ⍵}

    ⍝ A middlegame position with many captures, checks and castling
    ⍝ moves for both sides.
    KIWIPETE←'r3k2r/p1ppqpb1/bn2pnp1/3PN3/1p2P3/2N2Q1p/PPPBBPPP/R3K2R w KQkq - 0 1'

    ⍝ Each case: depth, FEN.
    test_alpha_beta_scores_a_position_as_negamax_does_cases←(
        ('quiet leaf'(0 'k7/8/8/8/8/8/P7/K7 w - - 0 1'))
        ('check extension'(0 CHECKED))
        ('checkmated'(2 'k7/1Q6/1K6/8/8/8/8/8 b - - 0 1'))
        ('stalemated'(1 'k7/8/1Q6/8/8/8/8/7K b - - 0 1'))
        ('won piece'(2 WON_PIECE))
        ('mate in one'(3 MATE_IN_ONE))
        ('back-rank mate threat'(3 BACK_RANK))
        ('start position, depth two'(2 START))
        ('start position, depth three'(3 START))
        ('middlegame'(2 KIWIPETE))
    )
    test_alpha_beta_scores_a_position_as_negamax_does←{
        (⍺ score ⍵)#.Tests.Framework.Assert.eq ⍺ abScore ⍵
    }

    ⍝ Each case: depth, FEN.
    test_alpha_beta_searches_fewer_positions_than_negamax_cases←(
        ('start position'(3 START))
        ('back-rank mate threat'(3 BACK_RANK))
        ('middlegame'(2 KIWIPETE))
    )
    test_alpha_beta_searches_fewer_positions_than_negamax←{
        #.Tests.Framework.Assert.ok(⍺ abNodes ⍵)<⍺ nodes ⍵
    }

    test_alpha_beta_counts_a_leaf_as_one_position←{
        1 #.Tests.Framework.Assert.eq ⍺ abNodes 0 'k7/8/8/8/8/8/P7/K7 w - - 0 1'
    }

    test_alpha_beta_counts_a_checkmated_position_as_one_position←{
        1 #.Tests.Framework.Assert.eq ⍺ abNodes 2 'k7/1Q6/1K6/8/8/8/8/8 b - - 0 1'
    }

    ⍝ Windows around the depth-two score of the won-piece position.

    test_alpha_beta_returns_the_exact_score_inside_the_window←{
        exact←⍺ abScore 2 WON_PIECE
        exact #.Tests.Framework.Assert.eq ⍺ abScore 2 WON_PIECE(exact-1)(exact+1)
    }

    test_alpha_beta_returns_at_most_alpha_when_the_score_is_below_the_window←{
        alpha←100+⍺ abScore 2 WON_PIECE
        #.Tests.Framework.Assert.ok alpha≥⍺ abScore 2 WON_PIECE alpha(alpha+100)
    }

    test_alpha_beta_returns_at_least_beta_when_the_score_is_above_the_window←{
        beta←(⍺ abScore 2 WON_PIECE)-100
        #.Tests.Framework.Assert.ok beta≤⍺ abScore 2 WON_PIECE(beta-100)beta
    }

:EndNamespace
