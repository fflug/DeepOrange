:Namespace UCI
    ⍝ Communication with chess GUIs over the UCI protocol.

    ⎕IO ⎕ML←1

    ⍝ Keywords in the arguments of the position command.
    POS_MOVES←'moves'
    POS_FEN←'fen'
    POS_STARTPOS←'startpos'

    ⍝ Commands from the GUI.
    CMD_UCI←'uci'
    CMD_ISREADY←'isready'
    CMD_UCINEWGAME←'ucinewgame'
    CMD_POSITION←'position'
    CMD_GO←'go'
    CMD_QUIT←'quit'

    ⍝ Replies to the GUI.
    REPLY_UCIOK←'uciok'
    REPLY_READYOK←'readyok'
    REPLY_BESTMOVE←'bestmove'
    ⍝ Move reported when the side to move has no legal move.
    NULL_MOVE←'0000'

    ID_LINES←'id name RandomAPL' 'id author Finn Flug'REPLY_UCIOK
    NO_REPLY←0⍴⊂''

    newState←{
        ⍝ Engine state at the start of a session.
        ⍝ ⍵ ←→ lookup tables
        ⍝ ← ←→ lookup tables, position (bitboards, game state), finished flag
        ⍵(##.Board.initBoard ⍬)0
    }

    finished←{
        ⍝ ⍵ ←→ engine state
        ⍝ ← ←→ 1 once quit has been received
        3⊃⍵
    }

    handle←{
        ⍝ Respond to one line of UCI input.
        ⍝ ⍺ ←→ engine state
        ⍝ ⍵ ←→ input line
        ⍝ ← ←→ engine state, vector of reply lines

        (lookups position done)←⍺
        words←' '(≠⊆⊢)⍵

        ⍝ UCI requires unknown commands and empty lines to be ignored.
        0=≢words:⍺ NO_REPLY
        (command args)←(⊃words)(1↓words)
        command≡CMD_UCI:⍺ ID_LINES
        command≡CMD_ISREADY:⍺(,⊂REPLY_READYOK)
        command≡CMD_UCINEWGAME:(newState lookups)NO_REPLY
        command≡CMD_POSITION:(lookups(handlePositionCmd args)done)NO_REPLY
        command≡CMD_GO:⍺(,⊂handleGoCmd lookups position)
        command≡CMD_QUIT:(lookups position 1)NO_REPLY
        ⍺ NO_REPLY
    }

    handleGoCmd←{
        ⍝ Search parameters are ignored; the move is chosen at random.
        ⍝ ⍵ ←→ lookup tables, position
        ⍝ ← ←→ bestmove reply; the null move when there is no legal move
        (lookups position)←⍵
        move←lookups ##.Search.randomMove position
        0=≢move:REPLY_BESTMOVE,' ',NULL_MOVE
        REPLY_BESTMOVE,' ',moveToUCI move
    }

    handlePositionCmd←{
        ⍝ Position described by the arguments of a UCI position command.
        ⍝ ⍵ ←→ words following 'position':
        ⍝      'startpos' ['moves' m1 m2 ...] or
        ⍝      'fen' <fen fields> ['moves' m1 m2 ...]
        ⍝ ← ←→ bitboards, game state after the moves

        after_moves←∨\⍵∊⊂POS_MOVES
        position←after_moves~⍛/⍵
        moves←1↓after_moves/⍵
        (initPosition position)applyMoves moves
    }

    initPosition←{
        ⍝ Position before the moves of a position command.
        ⍝ ⍵ ←→ 'startpos', or 'fen' followed by the FEN fields
        ⍝ ← ←→ bitboards, game state

        position_type←⊃⍵
        position_type≡POS_STARTPOS:##.Board.initBoard ⍬
        position_type≡POS_FEN:##.Board.initFromFEN 1↓⍵
    }

    applyMoves←{
        ⍝ Apply UCI moves to a position.
        ⍝ ⍺ ←→ bitboards, game state
        ⍝ ⍵ ←→ a UCI move string, or a vector of them in order played
        ⍝ ← ←→ bitboards, game state after the moves

        ⍝ Reduction runs right to left, so the moves are reversed and the
        ⍝ position placed last to apply the first move first.
        ⊃applyMove⍨/(⌽,⊆⍵),⊂⍺
    }

    applyMove←{
        ⍝ Apply a UCI move to a position.
        ⍝ ⍺ ←→ bitboards, game state
        ⍝ ⍵ ←→ UCI move string
        ⍝ ← ←→ bitboards, game state after the move
        side←(2⊃⍺)[##.GameState.side]
        ⍺ ##.MoveGeneration.makeMove side uciToMove ⍵
    }

    squareToIndex←{
        ⍝ Algebraic square name to board index; a1 ←→ 1, h1 ←→ 8, a2 ←→ 9, h8 ←→ 64.
        ⍝ ⍵ ←→ square name, e.g. 'e4'
        ⍝ ← ←→ index of square

        ('abcdefgh'⍳⊃⍵)+8×¯1+'12345678'⍳⊃⌽⍵
    }

    indexToSquare←{
        ⍝ Board index to algebraic square name; inverse of squareToIndex.
        ⍝ ⍵ ←→ board index
        ⍝ ← ←→ square name, e.g. 'e4'

        ⍝ Indices start at 1, so 8|⍵ is 0 for the h-file. The file
        ⍝ letters are rotated so h comes first.
        file←'habcdefg'[1+8|⍵]
        rank←⍕⌈⍵÷8
        file,rank
    }

    uciToMove←{
        ⍝ UCI move string to move.
        ⍝ ⍺ ←→ side to move (0 white, 1 black); UCI promotion letters
        ⍝      are lowercase for both sides, so the colour comes from ⍺
        ⍝ ⍵ ←→ UCI move string, e.g. 'e2e4', 'e7e8q'
        ⍝ ← ←→ move (from to promotion)

        from←squareToIndex 2↑⍵
        to←squareToIndex 2↑2↓⍵
        4=≢⍵:from to 0
        promotion←('pnbrqk'⍳⊃⌽⍵)⊃##.Pieces.(P N B R Q K)+6×⍺
        from to promotion
    }

    moveToUCI←{
        ⍝ Move to UCI move string.
        ⍝ ⍵ ←→ move (from to promotion)
        ⍝ ← ←→ UCI move string, e.g. 'e2e4', 'e7e8q'

        uci←∊indexToSquare¨2↑⍵
        promotion←⊃⌽⍵
        promotion=0:uci
        uci,←'pnbrqkpnbrqk'[##.Pieces.(P N B R Q K p n b r q k)⍳promotion]
        uci
    }

:EndNamespace