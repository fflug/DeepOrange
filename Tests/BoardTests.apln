:Namespace BoardTests
    ⎕IO ⎕ML←1

    ⍝ Each test parses its own FEN through parse, so a parser that cannot
    ⍝ load or crashes is reported per test rather than for the whole suite.
    parse←{#.Board.initFromFEN ⍵}
    bitboard←{⊃parse ⍵}
    state←{2⊃parse ⍵}
    on←{⍸(⊃parse ⍺)[⍵;]}

    ⍝ Piece placement

    test_returns_twelve_bitboards_of_sixty_four_squares←{
        12 64 #.Assert.eq ⍴bitboard #.Helpers.START
    }

    test_places_white_pawns_on_rank_two←{
        (#.Helpers.sqs'a2 b2 c2 d2 e2 f2 g2 h2')#.Assert.eq #.Helpers.START on #.Pieces.P
    }

    test_places_black_pawns_on_rank_seven←{
        (#.Helpers.sqs'a7 b7 c7 d7 e7 f7 g7 h7')#.Assert.eq #.Helpers.START on #.Pieces.p
    }

    test_places_white_king_on_e1←{
        (,#.Helpers.sq'e1')#.Assert.eq #.Helpers.START on #.Pieces.K
    }

    test_places_black_queen_on_d8←{
        (,#.Helpers.sq'd8')#.Assert.eq #.Helpers.START on #.Pieces.q
    }

    test_places_white_rooks_in_the_corners_of_rank_one←{
        (#.Helpers.sqs'a1 h1')#.Assert.eq #.Helpers.START on #.Pieces.R
    }

    test_leaves_ranks_three_to_six_empty←{
        (32⍴0)#.Assert.eq ∨⌿(bitboard #.Helpers.START)[;16+⍳32]
    }

    test_puts_at_most_one_piece_on_each_square←{
        #.Assert.ok ∧/1≥+⌿bitboard #.Helpers.START
    }

    test_expands_digits_into_empty_squares←{
        fen←'8/8/8/8/3N4/8/8/8 w - - 0 1'
        (,#.Helpers.sq'd4')#.Assert.eq fen on #.Pieces.N
    }

    test_initBoard_sets_up_the_start_position←{
        (parse #.Helpers.START)#.Assert.eq #.Board.initBoard ⍬
    }

    ⍝ Game state fields

    test_reads_white_to_move←{
        0 #.Assert.eq(state #.Helpers.START)[#.GameState.side]
    }

    test_reads_black_to_move←{
        1 #.Assert.eq(state'8/8/8/8/8/8/8/8 b - - 0 1')[#.GameState.side]
    }

    test_reads_castling_rights_cases←(
        ('all'('KQkq' (1 1 1 1)))
        ('none'('-' (0 0 0 0)))
        ('white kingside and black queenside'('Kq' (1 0 0 1)))
    )
    test_reads_castling_rights←{
        (field expected)←⍵
        expected #.Assert.eq(state'8/8/8/8/8/8/8/8 w ',field,' - 0 1')[#.GameState.castling_rights]
    }

    test_reads_en_passant_square_cases←(
        ('none'('-' 0))
        ('e3'('e3' 21))
        ('d6'('d6' 44))
    )
    test_reads_en_passant_square←{
        (field expected)←⍵
        expected #.Assert.eq(state'8/8/8/8/8/8/8/8 w - ',field,' 0 1')[#.GameState.en_passant_square]
    }

    test_reads_halfmove_and_fullmove_clocks←{
        5 42 #.Assert.eq(state'8/8/8/8/8/8/8/8 w - - 5 42')[#.GameState.(halfmove fullmove)]
    }

    test_defaults_clocks_when_fen_omits_them←{
        0 1 #.Assert.eq(state'8/8/8/8/8/8/8/8 w - -')[#.GameState.(halfmove fullmove)]
    }

:EndNamespace
