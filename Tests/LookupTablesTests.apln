:Namespace LookupTablesTests
    ⎕IO ⎕ML←1

    setup←{#.LookupTables.createLookupTables ⍬}

    ⍝ Ray directions, as indices into the first axis of the rays table.
    (NORTH SOUTH EAST WEST NORTHEAST NORTHWEST SOUTHEAST SOUTHWEST)←⍳8

    ray←{
        ⍝ ⍺ ←→ lookup tables
        ⍝ ⍵ ←→ direction, square name
        (direction square)←⍵
        ⊃⍺.rays[direction;#.Helpers.sq square]
    }

    ⍝ Knight

    test_knight_in_the_corner_reaches_two_squares←{
        (#.Helpers.sqs'c2 b3')#.Assert.eq ⍸⍺.knight[#.Helpers.sq'a1';]
    }

    test_knight_in_the_centre_reaches_eight_squares←{
        (#.Helpers.sqs'c2 e2 b3 f3 b5 f5 c6 e6')#.Assert.eq ⍸⍺.knight[#.Helpers.sq'd4';]
    }

    ⍝ King

    test_king_in_the_corner_reaches_three_squares←{
        (#.Helpers.sqs'b1 a2 b2')#.Assert.eq ⍸⍺.king[#.Helpers.sq'a1';]
    }

    test_king_in_the_centre_reaches_eight_squares←{
        (#.Helpers.sqs'd3 e3 f3 d4 f4 d5 e5 f5')#.Assert.eq ⍸⍺.king[#.Helpers.sq'e4';]
    }

    ⍝ Pawn captures: first axis is 1 for white, 2 for black.

    test_white_pawn_attacks_both_forward_diagonals←{
        (#.Helpers.sqs'd3 f3')#.Assert.eq ⍸⍺.pawn[1;#.Helpers.sq'e2';]
    }

    test_white_pawn_on_the_a_file_attacks_one_square←{
        (,#.Helpers.sq'b3')#.Assert.eq ⍸⍺.pawn[1;#.Helpers.sq'a2';]
    }

    test_black_pawn_attacks_both_forward_diagonals←{
        (#.Helpers.sqs'd6 f6')#.Assert.eq ⍸⍺.pawn[2;#.Helpers.sq'e7';]
    }

    test_black_pawn_on_the_h_file_attacks_one_square←{
        (,#.Helpers.sq'g6')#.Assert.eq ⍸⍺.pawn[2;#.Helpers.sq'h7';]
    }

    ⍝ Rays: ordered from the nearest square outwards.

    test_rays_cases←(
        ('north from a1'(NORTH'a1' 'a2 a3 a4 a5 a6 a7 a8'))
        ('south from e4'(SOUTH'e4' 'e3 e2 e1'))
        ('east from a1'(EAST'a1' 'b1 c1 d1 e1 f1 g1 h1'))
        ('west from c3'(WEST'c3' 'b3 a3'))
        ('northeast from a1'(NORTHEAST'a1' 'b2 c3 d4 e5 f6 g7 h8'))
        ('northwest from e4'(NORTHWEST'e4' 'd5 c6 b7 a8'))
        ('southeast from d4'(SOUTHEAST'd4' 'e3 f2 g1'))
        ('southwest from h8'(SOUTHWEST'h8' 'g7 f6 e5 d4 c3 b2 a1'))
    )
    test_rays←{
        (direction square expected)←⍵
        (#.Helpers.sqs expected)#.Assert.eq ⍺ ray direction square
    }

    test_ray_off_the_board_is_empty←{
        ⍬ #.Assert.eq ⍺ ray NORTH'a8'
    }

:EndNamespace
