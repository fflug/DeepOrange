:Namespace MoveGenerationTests
    ⎕IO ⎕ML←1
    A←#.Assert
    H←#.Helpers

    ⍝ moves are rows of (from to promotion); promotion is 0 for a
    ⍝ non-promoting move, otherwise the piece type promoted to.

    setup←{#.LookupTables.createLookupTables ⍬}

    moves←{
        ⍝ ⍺ ←→ lookup tables
        ⍝ ⍵ ←→ FEN
        H.sortRows ⍺ #.MoveGeneration.generatePseudoLegalMoves #.Board.initFromFEN ⍵
    }

    from←{
        ⍝ moves from one square.
        ⍝ ⍺ ←→ move matrix
        ⍝ ⍵ ←→ square name
        ⍺⌿⍨⍺[;1]=H.sq ⍵
    }

    targets←{
        ⍝ Destination squares of the moves from one square.
        (⍺ from ⍵)[;2]
    }

    row←{
        ⍝ 'e2 e4' ←→ from to 0
        (H.sqs ⍵),0
    }

    ⍝ Start position

    test_start_position_has_twenty_moves_for_white←{
        20 A.eq ≢⍺ moves H.START
    }

    test_start_position_has_twenty_moves_for_black←{
        20 A.eq ≢⍺ moves'rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR b KQkq - 0 1'
    }

    test_knight_on_g1_reaches_f3_and_h3←{
        (H.sqs'f3 h3')A.eq(⍺ moves H.START)targets'g1'
    }

    test_never_moves_onto_own_pieces←{
        own←∨⌿(⊃#.Board.initFromFEN H.START)[⍳6;]
        A.ok ~∨/own[(⍺ moves H.START)[;2]]
    }

    ⍝ Pawns

    test_pawn_on_home_rank_can_push_one_or_two_squares←{
        (H.sqs'e3 e4')A.eq(⍺ moves'k7/8/8/8/8/8/4P3/K7 w - - 0 1')targets'e2'
    }

    test_pawn_off_home_rank_pushes_one_square←{
        (,H.sq'e4')A.eq(⍺ moves'k7/8/8/8/8/4P3/8/K7 w - - 0 1')targets'e3'
    }

    test_black_pawn_pushes_towards_rank_one←{
        (H.sqs'd5 d6')A.eq(⍺ moves'k7/3p4/8/8/8/8/8/K7 b - - 0 1')targets'd7'
    }

    test_blocked_pawn_cannot_push←{
        ⍬ A.eq(⍺ moves'k7/8/8/4p3/4P3/8/8/K7 w - - 0 1')targets'e4'
    }

    test_pawn_cannot_double_push_through_a_piece←{
        ⍬ A.eq(⍺ moves'k7/8/8/8/8/4n3/4P3/K7 w - - 0 1')targets'e2'
    }

    test_pawn_captures_diagonally←{
        (H.sqs'd5 e5')A.eq(⍺ moves'k7/8/8/3p4/4P3/8/8/K7 w - - 0 1')targets'e4'
    }

    test_pawn_captures_en_passant←{
        A.ok(⊂row'e5 d6')∊↓⍺ moves'k7/8/8/3pP3/8/8/8/K7 w - d6 0 1'
    }

    test_pawn_reaching_the_last_rank_promotes_to_four_pieces←{
        expected←H.sortRows(4 2⍴H.sqs'e7 e8'),#.Pieces.(Q R B N)
        expected A.eq(⍺ moves'k7/4P3/8/8/8/8/8/K7 w - - 0 1')from'e7'
    }

    ⍝ Sliding pieces

    test_rook_is_blocked_by_own_pieces←{
        (H.sqs'b1 c1 d1 e1 f1 g1')A.eq(⍺ moves'k7/8/8/8/8/8/P7/R6K w - - 0 1')targets'a1'
    }

    test_rook_captures_the_first_enemy_piece_and_stops←{
        (H.sqs'b1 c1 d1 e1 f1 g1 a2 a3')A.eq(⍺ moves'k7/8/8/8/8/p7/8/R6K w - - 0 1')targets'a1'
    }

    test_bishop_moves_diagonally_only←{
        expected←H.sqs'b1 d1 b3 d3 a4 e4 f5 g6 h7'
        (expected[⍋expected])A.eq(⍺ moves'k7/8/8/8/8/8/2B5/K7 w - - 0 1')targets'c2'
    }

    test_queen_in_the_corner_of_an_empty_board_has_twenty_one_moves←{
        21 A.eq ≢(⍺ moves'6k1/8/8/8/8/7K/8/Q7 w - - 0 1')from'a1'
    }

    ⍝ Attacked squares

    attacked←{
        ⍝ ⍺ ←→ lookup tables
        ⍝ ⍵ ←→ FEN, square names, attacking side (0 white, 1 black)
        ⍝ ← ←→ one boolean per square name
        (fen names side)←⍵
        bitboards←⊃#.Board.initFromFEN fen
        ⍺ #.MoveGeneration.checkSquareAttacked bitboards(H.sqs names)side
    }

    test_square_far_from_all_pieces_is_not_attacked←{
        (,0)A.eq ⍺ attacked'4k3/8/8/8/8/8/8/4K3 w - - 0 1' 'd4' 1
    }

    test_white_pawn_attacks_diagonally_forward_only←{
        1 0 1 0 A.eq ⍺ attacked'k7/8/8/8/4P3/8/8/K7 w - - 0 1' 'd5 e5 f5 d3' 0
    }

    test_black_pawn_attacks_diagonally_towards_rank_one←{
        1 0 1 0 A.eq ⍺ attacked'k7/8/8/4p3/8/8/8/K7 w - - 0 1' 'd4 e4 f4 d6' 1
    }

    test_knight_attacks_its_jump_squares←{
        1 1 0 A.eq ⍺ attacked'k7/8/8/8/8/8/8/K5n1 w - - 0 1' 'f3 h3 g3' 1
    }

    test_king_attacks_adjacent_squares←{
        1 1 0 A.eq ⍺ attacked'k7/8/8/8/8/8/8/K7 w - - 0 1' 'b8 b7 c8' 1
    }

    test_rook_attack_stops_at_the_first_piece←{
        1 1 0 A.eq ⍺ attacked'k7/8/8/8/N7/8/8/r6K w - - 0 1' 'a3 a4 a5' 1
    }

    test_rook_does_not_attack_diagonally←{
        (,0)A.eq ⍺ attacked'k7/8/8/8/8/8/8/r6K w - - 0 1' 'b2' 1
    }

    test_bishop_attack_stops_at_the_first_piece←{
        1 1 0 A.eq ⍺ attacked'k7/8/8/8/8/4P3/8/2b4K w - - 0 1' 'd2 e3 f4' 1
    }

    test_bishop_does_not_attack_orthogonally←{
        (,0)A.eq ⍺ attacked'k7/8/8/8/8/8/8/2b4K w - - 0 1' 'c2' 1
    }

    test_queen_attacks_orthogonally_and_diagonally←{
        1 1 0 A.eq ⍺ attacked'k7/8/8/8/8/8/8/3q3K w - - 0 1' 'd5 g4 e3' 1
    }

    test_pieces_of_the_other_side_do_not_count_as_attackers←{
        (,0)A.eq ⍺ attacked'k7/8/8/8/8/8/8/R6K w - - 0 1' 'a4' 1
    }

    test_white_pieces_attack_when_white_is_the_attacking_side←{
        (,1)A.eq ⍺ attacked'k7/8/8/8/8/8/8/R6K w - - 0 1' 'a4' 0
    }

    ⍝ Castling
    ⍝ A castling move is the king's two-square move, e.g. e1 g1 0.

    test_white_castles_kingside←{
        A.ok(⊂row'e1 g1')∊↓⍺ moves'r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1'
    }

    test_white_castles_queenside←{
        A.ok(⊂row'e1 c1')∊↓⍺ moves'r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1'
    }

    test_black_castles_kingside←{
        A.ok(⊂row'e8 g8')∊↓⍺ moves'r3k2r/8/8/8/8/8/8/R3K2R b KQkq - 0 1'
    }

    test_black_castles_queenside←{
        A.ok(⊂row'e8 c8')∊↓⍺ moves'r3k2r/8/8/8/8/8/8/R3K2R b KQkq - 0 1'
    }

    test_king_with_both_castling_rights_has_seven_moves←{
        (H.sqs'c1 d1 f1 g1 d2 e2 f2')A.eq(⍺ moves'r3k2r/8/8/8/8/8/8/R3K2R w KQkq - 0 1')targets'e1'
    }

    test_king_cannot_castle_without_castling_rights←{
        (H.sqs'd1 f1 d2 e2 f2')A.eq(⍺ moves'r3k2r/8/8/8/8/8/8/R3K2R w - - 0 1')targets'e1'
    }

    test_kingside_right_alone_does_not_permit_queenside_castling←{
        (H.sqs'd1 f1 g1 d2 e2 f2')A.eq(⍺ moves'r3k2r/8/8/8/8/8/8/R3K2R w K - 0 1')targets'e1'
    }

    test_white_rights_do_not_let_black_castle←{
        (H.sqs'd7 e7 f7 d8 f8')A.eq(⍺ moves'r3k2r/8/8/8/8/8/8/R3K2R b KQ - 0 1')targets'e8'
    }

    test_king_cannot_castle_kingside_through_a_piece←{
        A.ok~(⊂row'e1 g1')∊↓⍺ moves'r3k2r/8/8/8/8/8/8/R3K1NR w KQkq - 0 1'
    }

    test_king_cannot_castle_queenside_when_b1_is_occupied←{
        A.ok~(⊂row'e1 c1')∊↓⍺ moves'r3k2r/8/8/8/8/8/8/RN2K2R w KQkq - 0 1'
    }

    test_king_cannot_castle_out_of_check←{
        targets←(⍺ moves'4k3/8/8/4r3/8/8/8/R3K2R w KQ - 0 1')targets'e1'
        A.ok~∨/(H.sqs'c1 g1')∊targets
    }

    test_king_cannot_castle_kingside_across_an_attacked_square←{
        A.ok~(⊂row'e1 g1')∊↓⍺ moves'4k3/8/8/5r2/8/8/8/R3K2R w KQ - 0 1'
    }

    test_king_cannot_castle_queenside_across_an_attacked_square←{
        A.ok~(⊂row'e1 c1')∊↓⍺ moves'4k3/8/8/3r4/8/8/8/R3K2R w KQ - 0 1'
    }

    test_attacked_b1_does_not_prevent_queenside_castling←{
        A.ok(⊂row'e1 c1')∊↓⍺ moves'4k3/8/8/1r6/8/8/8/R3K2R w KQ - 0 1'
    }

:EndNamespace
