:Namespace Tester
    ⍝ A simple test runner.
    ⍝
    ⍝ A suite is a namespace. A test is a function whose name starts with
    ⍝ test_, called as:  fixture test case
    ⍝   fixture  result of the suite's optional setup, run once per suite;
    ⍝            ⍬ when the suite has no setup
    ⍝   case     data from the optional <test>_cases vector of (label data)
    ⍝            pairs; ⍬ otherwise

    ⎕IO ⎕ML←1

    ⍝ Error number that marks an assertion failure (FAIL) as opposed to
    ⍝ any other error (ERROR).
    FAIL_EN←777

    ⍝ Names of test functions are test_*
    TEST_FN_PREFIX←'test_'

    ⍝ Names of testcases are test function names followed by _cases
    CASES_POSTFIX←'_cases'

    STATUS_ERROR←'ERROR'
    STATUS_FAIL←'FAIL'
    STATUS_PASS←'PASS'
    STATUS_SKIP←'SKIP'

    ⍝ Columns of the result matrix
    RESULTS_COLS←'suite' 'test' 'status' 'message'

    ⍝ Runner

    run←{
        ⍝ ⍵ ←→ suite reference, or vector of suite references
        ⍝ ← ←→ results matrix, one row per test case:
        ⍝      suite name, test name, status, message
        ⍝      status is one of 'PASS' 'FAIL' 'ERROR'
        results←⊃⍪/(⊂0 4⍴⊂''),runSuite¨,⍵
        ⍞←report results
        results
    }

    runSuite←{
        ⍝ ⍵ ←→ suite reference
        ⍝ ← ←→ results matrix, one row per test case
        suite←⍵
        suite_name←⊃⌽'.'(≠⊆⊢)⍕suite
        test_fns←TEST_FN_PREFIX∘(⊃⍷)¨⍛/suite.⎕NL ¯3
        0=≢test_fns:0 4⍴⊂''
        test_cases←suite ⎕VGET(↑test_fns,¨⊂CASES_POSTFIX)(⊂,⊂''⍬)
        test_cases_full←⊃,/test_fns(⊂⍤⊣⊂⍛,¨⊢)¨test_cases
        (setup_ok fixture)←runSetup suite
        row←{suite_name(getDisplayName 2↑⍵),⍺⍺ ⍵}
        ~setup_ok:↑{STATUS_ERROR fixture}row¨test_cases_full
        ↑{fixture runOne suite,⍵[1 3]}row¨test_cases_full
    }

    runSetup←{
        ⍝ ⍵ ←→ suite reference
        ⍝ ← ←→ 1 fixture, or 0 message when setup signals an error.
        ⍝ Separate dfn so the error guard covers only the setup call.
        3≠⍵.⎕NC'setup':1 ⍬
        0::0('setup failed: ',getErrorText ⍬)
        1(⍵.setup ⍬)
    }

    getDisplayName←{
        ⍝ ⍵ ←→ test_fn_name label
        ⍝ ← ←→ 'fn name [label]', or 'fn name' when label is empty
        (test_fn_name label)←⍵
        display←' '@('_'∘=)(≢TEST_FN_PREFIX)↓test_fn_name
        display,(0≠≢label)/' [',label,']'
    }

    runOne←{
        ⍝ ⍺ ←→ fixture
        ⍝ ⍵ ←→ suite name case
        ⍝ ← ←→ status message
        (suite name case)←⍵
        test←suite⍎name
        0::(1+FAIL_EN=⎕DMX.EN)⊃(STATUS_ERROR(getErrorText ⍬))(STATUS_FAIL ⎕DMX.Message)
        _←⍺ test case
        STATUS_PASS''
    }

    getErrorText←{
        ⍝ Error name, message and offending line from the current ⎕DMX.
        (em dm msg)←⎕DMX.(EM DM Message)
        line←⊃' '(≠⊆⊢)2⊃dm
        em,((0≠≢msg)/': ',msg),(0≠≢line)/' in: ',line
    }

    ⍝ Reporting

    report←{
        ⍝ Create a report from the result matrix
        ⍝ ⍵ ←→ results matrix
        ⍝ ← ←→ report text

        lf←⎕UCS 10
        getCol←{⍵[;RESULTS_COLS⍳⊂⍺]}

        status←'status'getCol ⍵

        ⍝ One row per test
        out←↑status
        out,←' ',↑'suite'getCol ⍵
        out,←' ',↑'test'getCol ⍵

        ⍝ Add message below lines which report a fail or an error
        show_msg←status∊STATUS_FAIL STATUS_ERROR
        lines←↓out
        lines[⍸show_msg],←(lf,6⍴' ')∘,¨show_msg/'message'getCol ⍵
        
        ⍝ Add summary
        counts←+/STATUS_PASS STATUS_FAIL STATUS_ERROR STATUS_SKIP∘.≡status
        words←'passed' 'failed' 'errored' 'skipped'
        summary←lf,¯2↓∊(⍕¨counts),¨' ',¨words,¨⊂', '

        ∊(lines,⊂summary),¨lf
    }

    failed←{
        ⍝ ⍵ ←→ results matrix from run
        ⍝ ← ←→ 1 if any test failed or errored
        ∨/(⍵[;3])∊STATUS_FAIL STATUS_ERROR
    }

:EndNamespace
